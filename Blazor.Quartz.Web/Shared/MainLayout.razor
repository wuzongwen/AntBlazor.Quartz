@inherits LayoutComponentBase
@inject NotificationService _notice
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@using Blazor.Quartz.Core.Service.Timer.Dto

<div class="sidebar">
    <NavMenu />
</div>

<div class="main">
    <div class="top-row px-4">
        <AuthorizeView>
            <Dropdown>
                <Overlay>
                    <ul class="ant-dropdown-menu ant-dropdown-menu-root">
                        <li class="ant-dropdown-menu-item" @onclick="OnClick">
                            <Icon Type="info-circle" Theme="@IconThemeType.Outline" />
                            <span style="margin-left: 8px">约定返回模型</span>
                        </li>
                        <li class="ant-dropdown-menu-item" @onclick="OnClick2">
                            <Icon Type="home" Theme="@IconThemeType.Outline" />
                            <span style="margin-left: 8px">项目主页</span>
                        </li>
                        <li class="ant-dropdown-menu-item-divider" role="separator" aria-orientation="horizontal"></li>
                        <li class="ant-dropdown-menu-item" @onclick="OnLogout">
                            <Icon Type="logout" Theme="@IconThemeType.Outline" />
                            <span style="margin-left: 8px">退出登录</span>
                        </li>
                    </ul>
                </Overlay>
                <ChildContent>
                    <span class="user-dropdown-trigger">
                        <Icon Type="user" Theme="@IconThemeType.Outline" />
                        @context.User.Identity?.Name
                        <Icon Type="down" Theme="@IconThemeType.Outline" />
                    </span>
                </ChildContent>
            </Dropdown>
        </AuthorizeView>
    </div>

    <div class="content px-4">
        @Body
    </div>
</div>
@code {
    //protected override async Task OnInitializedAsync()
    //{
    //    await Task.Run(() =>
    //    {
    //        NavigationManager.NavigateTo("http://www.baidu.com", true);
    //    });
    //}

    private async Task OnClick()
    {
        var reqModel = new HttpResultModel() { resCode = 0, resMsg = "成功", isSuccess = true };
        await _notice.Open(new NotificationConfig()
            {
                Message = "约定返回模型",
                Duration = 3.5,
                Description = $"{JsonConvert.SerializeObject(reqModel) }"
            });
    }

    private async Task OnClick2()
    {
        await _notice.Open(new NotificationConfig()
            {
                Message = "项目主页",
                Duration = 5.5,
                Description = "https://github.com/wuzongwen/AntBlazor.Quartz"
            });
    }

    /// <summary>
    /// 退出登录（清除登录Cookie后回到登录页）
    /// </summary>
    /// <returns></returns>
    private async Task OnLogout()
    {
        try
        {
            await JS.InvokeAsync<string>("loginManager.postJson", "/api/Login/Out", "{}");
        }
        catch { }
        NavigationManager.NavigateTo("/login", true);
    }
}
