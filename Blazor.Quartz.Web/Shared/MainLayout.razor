@inherits LayoutComponentBase
@inject NotificationService _notice
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject MessageService _message
@using Blazor.Quartz.Core.Service.Timer.Dto
@using Blazor.Quartz.Core.Service.Admin.Dto
@using Blazor.Quartz.Core.Service.Base.Dto

<div class="sidebar">
    <NavMenu />
</div>

<div class="main">
    <div class="top-row px-4">
        <AuthorizeView>
            <Dropdown>
                <Overlay>
                    <ul class="ant-dropdown-menu ant-dropdown-menu-root">
                        <li class="ant-dropdown-menu-item" @onclick="OnClick">
                            <Icon Type="info-circle" Theme="@IconThemeType.Outline" />
                            <span style="margin-left: 8px">约定返回模型</span>
                        </li>
                        <li class="ant-dropdown-menu-item" @onclick="OnClick2">
                            <Icon Type="home" Theme="@IconThemeType.Outline" />
                            <span style="margin-left: 8px">项目主页</span>
                        </li>
                        <li class="ant-dropdown-menu-item-divider" role="separator" aria-orientation="horizontal"></li>
                        <li class="ant-dropdown-menu-item" @onclick="OpenChangePasswordModal">
                            <Icon Type="key" Theme="@IconThemeType.Outline" />
                            <span style="margin-left: 8px">修改密码</span>
                        </li>
                        <li class="ant-dropdown-menu-item" @onclick="OnLogout">
                            <Icon Type="logout" Theme="@IconThemeType.Outline" />
                            <span style="margin-left: 8px">退出登录</span>
                        </li>
                    </ul>
                </Overlay>
                <ChildContent>
                    <span class="user-dropdown-trigger">
                        <Icon Type="user" Theme="@IconThemeType.Outline" />
                        @context.User.Identity?.Name
                        <Icon Type="down" Theme="@IconThemeType.Outline" />
                    </span>
                </ChildContent>
            </Dropdown>
        </AuthorizeView>
    </div>

    <div class="content px-4">
        @Body
    </div>
</div>

<Modal Title="修改密码"
       Visible="@pwdModalVisible"
       ConfirmLoading="@pwdSubmitting"
       OkText='@("确定")'
       CancelText='@("取消")'
       MaskClosable="false"
       OnOk="HandleChangePassword"
       OnCancel="ClosePwdModal">
    <Form Model="pwdModel">
        <FormItem Label="原密码">
            <InputPassword @bind-Value="pwdModel.OLD_PASSWORD" Placeholder="请输入原密码" />
        </FormItem>
        <FormItem Label="新密码">
            <InputPassword @bind-Value="pwdModel.NEW_PASSWORD" Placeholder="请输入新密码（6-32位）" />
        </FormItem>
        <FormItem Label="确认新密码">
            <InputPassword @bind-Value="pwdModel.CONFIRM_PASSWORD" Placeholder="请再次输入新密码" OnPressEnter="HandleChangePassword" />
        </FormItem>
    </Form>
</Modal>

@code {
    //protected override async Task OnInitializedAsync()
    //{
    //    await Task.Run(() =>
    //    {
    //        NavigationManager.NavigateTo("http://www.baidu.com", true);
    //    });
    //}

    private async Task OnClick()
    {
        var reqModel = new HttpResultModel() { resCode = 0, resMsg = "成功", isSuccess = true };
        await _notice.Open(new NotificationConfig()
            {
                Message = "约定返回模型",
                Duration = 3.5,
                Description = $"{JsonConvert.SerializeObject(reqModel) }"
            });
    }

    private async Task OnClick2()
    {
        await _notice.Open(new NotificationConfig()
            {
                Message = "项目主页",
                Duration = 5.5,
                Description = "https://github.com/wuzongwen/AntBlazor.Quartz"
            });
    }

    /// <summary>
    /// 退出登录（清除登录Cookie后回到登录页）
    /// </summary>
    /// <returns></returns>
    private async Task OnLogout()
    {
        try
        {
            await JS.InvokeAsync<string>("loginManager.postJson", "/api/Login/Out", "{}");
        }
        catch { }
        NavigationManager.NavigateTo("/login", true);
    }

    private ChangePasswordDto pwdModel = new ChangePasswordDto();
    private bool pwdModalVisible = false;
    private bool pwdSubmitting = false;

    /// <summary>
    /// 打开修改密码弹窗
    /// </summary>
    private void OpenChangePasswordModal()
    {
        pwdModel = new ChangePasswordDto();
        pwdModalVisible = true;
    }

    /// <summary>
    /// 关闭修改密码弹窗并清空表单
    /// </summary>
    private void ClosePwdModal()
    {
        pwdModalVisible = false;
        pwdModel = new ChangePasswordDto();
    }

    /// <summary>
    /// 提交修改密码（成功后服务端已清除登录Cookie，整页跳转登录页重新登录）
    /// </summary>
    /// <returns></returns>
    private async Task HandleChangePassword()
    {
        //前端基础校验，完整规则由服务端统一校验
        if (string.IsNullOrWhiteSpace(pwdModel.OLD_PASSWORD)
            || string.IsNullOrWhiteSpace(pwdModel.NEW_PASSWORD)
            || string.IsNullOrWhiteSpace(pwdModel.CONFIRM_PASSWORD))
        {
            await _message.ErrorAsync("请填写完整的密码信息");
            return;
        }

        if (pwdModel.NEW_PASSWORD.Length < 6 || pwdModel.NEW_PASSWORD.Length > 32)
        {
            await _message.ErrorAsync("新密码长度需在6-32位之间");
            return;
        }

        if (pwdModel.NEW_PASSWORD != pwdModel.CONFIRM_PASSWORD)
        {
            await _message.ErrorAsync("两次输入的新密码不一致");
            return;
        }

        pwdSubmitting = true;
        try
        {
            //由浏览器发起同源请求携带登录Cookie调用修改密码接口
            var json = JsonConvert.SerializeObject(pwdModel);
            var resultJson = await JS.InvokeAsync<string>("loginManager.postJson", "/api/Login/ChangePassword", json);
            var result = JsonConvert.DeserializeObject<BaseResult>(resultJson);
            if (result != null && result.Code == 200)
            {
                //先恢复按钮状态并关闭弹窗，再短暂展示成功提示（1秒）后跳转登录页，
                //避免await消息Task（默认3秒）导致按钮/页面空转
                pwdSubmitting = false;
                pwdModalVisible = false;
                StateHasChanged();
                await _message.SuccessAsync("密码修改成功，请重新登录", 1);
                NavigationManager.NavigateTo("/login", true);
            }
            else
            {
                pwdSubmitting = false;
                StateHasChanged();
                await _message.ErrorAsync(result?.Msg ?? "修改密码失败");
            }
        }
        catch (Exception)
        {
            pwdSubmitting = false;
            StateHasChanged();
            await _message.ErrorAsync("修改密码失败，请稍后重试");
        }
        finally
        {
            pwdSubmitting = false;
        }
    }
}
